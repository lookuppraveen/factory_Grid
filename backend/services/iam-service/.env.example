# Copy to `.env` in this folder (git-ignored) and fill in real values.
# scripts/start-iam.ps1 loads this file before starting the service.

# --- PostgreSQL (required) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=factorygrid
DB_USERNAME=postgres
DB_PASSWORD=<your-local-postgres-password>
# Used only by Maven tests
TEST_DB_NAME=factorygrid_test

# --- JWT (required, at least 32 characters, random) ---
# PowerShell: -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 64 | % {[char]$_})
JWT_SECRET=<generate-a-random-secret-of-64-characters>
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# --- Server / CORS ---
SERVER_PORT=8081
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Controlled admin provisioning (keep disabled after first run) ---
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@factorygrid.com
BOOTSTRAP_ADMIN_PASSWORD=<strong-admin-password-only-when-enabled>
