# Copy to .env in this folder (git-ignored) and fill in real values.

# --- Server ---
PORT=8081
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# --- PostgreSQL (docker compose up -d gives you this one) ---
DATABASE_URL=postgresql://factorygrid:factorygrid@localhost:5442/factorygrid

# --- JWT (required, at least 32 characters, random) ---
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=<generate-a-random-secret-of-64-characters>
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# --- One-off admin creation: pnpm --filter factorygrid-api db:seed-admin ---
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@factorygrid.com
BOOTSTRAP_ADMIN_PASSWORD=
