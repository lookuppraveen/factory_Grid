# ==============================================================================
# FactoryGrid Backend Environment Configuration (.env.example)
# ==============================================================================

# --- Server Port (Supports both PORT and SERVER_PORT) ---
PORT=8081
SERVER_PORT=8081

# --- CORS Allowed Origins (Comma-separated) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,https://factorygrid.onrender.com

# --- Database: Option A (Direct Connection URL - Recommended for Cloud/Managed DB) ---
DATABASE_URL=postgresql://factorygrid:factorygrid@localhost:5442/factorygrid

# --- Database: Option B (Individual Host Variables - Spring Boot Compatible) ---
# DB_HOST=localhost
# DB_PORT=5442
# DB_NAME=factorygrid
# DB_USERNAME=factorygrid
# DB_PASSWORD=factorygrid

# --- JWT Authentication (Required, at least 32 characters) ---
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=super-secure-production-jwt-signing-secret-key-factorygrid-2026-64bytes-min
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# --- One-off Platform Admin Bootstrap ---
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@factorygrid.com
BOOTSTRAP_ADMIN_PASSWORD=Admin12345678

# --- MinIO / S3 Object Storage ---
S3_ENDPOINT=http://127.0.0.1:9010
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=factorygrid
S3_SECRET_ACCESS_KEY=factorygrid-dev
S3_BUCKET=factorygrid-documents
S3_FORCE_PATH_STYLE=true

# --- Throttler ---
THROTTLE_DISABLED=false
