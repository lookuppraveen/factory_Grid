model OrderArtwork {
  id              BigInt       @id @default(autoincrement())
  masterOrderId   BigInt       @map("master_order_id")
  subOrderId      BigInt?      @map("sub_order_id")
  productId       String       @map("product_id") @db.VarChar(100)
  productName     String?      @map("product_name") @db.VarChar(250)
  submissionType  String       @default("UPLOAD") @map("submission_type") @db.VarChar(50)
  fileName        String?      @map("file_name") @db.VarChar(255)
  fileType        String?      @map("file_type") @db.VarChar(100)
  fileSize        String?      @map("file_size") @db.VarChar(50)
  fileUrl         String?      @map("file_url") @db.VarChar(1000)
  storageKey      String?      @map("storage_key") @db.VarChar(500)
  externalUrl     String?      @map("external_url") @db.VarChar(1000)
  instructions    String?      @db.Text
  status          String       @default("SUBMITTED") @db.VarChar(50)
  reviewNotes     String?      @map("review_notes") @db.Text
  reviewedBy      String?      @map("reviewed_by") @db.VarChar(100)
  reviewedAt      DateTime?    @map("reviewed_at") @db.Timestamptz(6)
  uploadedById    BigInt?      @map("uploaded_by_id")
  uploadedByName  String?      @map("uploaded_by_name") @db.VarChar(150)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  masterOrder     MasterOrder  @relation(fields: [masterOrderId], references: [id], onDelete: Cascade)
