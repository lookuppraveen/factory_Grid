  @@index([masterOrderId], map: "idx_order_artwork_master_order_id")
  @@index([subOrderId], map: "idx_order_artwork_sub_order_id")
  @@index([productId], map: "idx_order_artwork_product_id")
  @@index([status], map: "idx_order_artwork_status")
  @@map("order_artwork")
}
