model MasterOrder {
  id                     BigInt             @id @default(autoincrement())
  orderNumber            String             @unique @map("order_number") @db.VarChar(50)
  rfqId                  BigInt?            @map("rfq_id")
  quoteId                BigInt?            @map("quote_id")
  buyerId                BigInt?            @map("buyer_id")
  buyerRegistrationId    BigInt?            @map("buyer_registration_id")
  customerName           String             @map("customer_name") @db.VarChar(250)
  customerCode           String?            @map("customer_code") @db.VarChar(50)
  customerClassification String?            @default("B2B") @map("customer_classification") @db.VarChar(50)
  totalAmount            Decimal            @default(0) @map("total_amount") @db.Decimal(14, 2)
  totalQuantity          Int                @default(0) @map("total_quantity")
  status                 String             @default("PENDING_ADMIN_APPROVAL") @db.VarChar(50)
  adminApprovalStatus    String?            @default("PENDING") @map("admin_approval_status") @db.VarChar(50)
  advanceRequired        Boolean            @default(false) @map("advance_required")
  advanceStatus          String?            @default("NOT_REQUIRED") @map("advance_status") @db.VarChar(50)
  advanceMethod          String?            @default("PERCENTAGE") @map("advance_method") @db.VarChar(50)
  advancePercentage      Decimal?           @map("advance_percentage") @db.Decimal(5, 2)
  advanceAmount          Decimal?           @default(0) @map("advance_amount") @db.Decimal(14, 2)
  advanceReceived        Decimal?           @default(0) @map("advance_received") @db.Decimal(14, 2)
  advanceOutstanding     Decimal            @default(0) @map("advance_outstanding") @db.Decimal(14, 2)
  advanceDueDate         DateTime?          @map("advance_due_date") @db.Date
  advanceNotes           String?            @map("advance_notes") @db.Text
  isOnHold               Boolean            @default(false) @map("is_on_hold")
  holdReason             String?            @map("hold_reason") @db.Text
  holdCount              Int                @default(0) @map("hold_count")
  holdPlacedAt           DateTime?          @map("hold_placed_at") @db.Timestamptz(6)
  holdPlacedBy           String?            @map("hold_placed_by") @db.VarChar(100)
  adminApprovedAt        DateTime?          @map("admin_approved_at") @db.Timestamptz(6)
  adminApprovedBy        String?            @map("admin_approved_by") @db.VarChar(100)
  adminRejectionReason   String?            @map("admin_rejection_reason") @db.Text
  paymentTerms           String?            @map("payment_terms") @db.VarChar(255)
  orderDate              DateTime           @default(now()) @map("order_date") @db.Date
  expectedDeliveryDate   DateTime?          @map("expected_delivery_date") @db.Date
  shippingAddress        String?            @map("shipping_address") @db.Text
  billingAddress         String?            @map("billing_address") @db.Text
  buyerGst               String?            @map("buyer_gst") @db.VarChar(50)
  remarks                String?            @db.Text
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  rfq                    Rfq?               @relation(fields: [rfqId], references: [id], onDelete: SetNull)
  quote                  Quote?             @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  buyer                  User?              @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  buyerRegistration      BuyerRegistration? @relation(fields: [buyerRegistrationId], references: [id], onDelete: SetNull)
  subOrders              SubOrder[]
  purchaseOrders         PurchaseOrder[]
  statusHistory          OrderStatusHistory[]
  artworks               OrderArtwork[]

  @@index([rfqId], map: "idx_master_orders_rfq_id")
  @@index([buyerId], map: "idx_master_orders_buyer_id")
  @@index([status], map: "idx_master_orders_status")
  @@map("master_orders")
}

model SubOrder {
  id                 BigInt                   @id @default(autoincrement())
  subOrderNumber     String                   @unique @map("sub_order_number") @db.VarChar(50)
  masterOrderId      BigInt                   @map("master_order_id")
  manufacturerId     BigInt                   @map("manufacturer_id")
  quoteId            BigInt?                  @map("quote_id")
  status             String                   @default("AWAITING_ACCEPTANCE") @db.VarChar(50)
  productionStatus   String?                  @default("AWAITING_ACCEPTANCE") @map("production_status") @db.VarChar(50)
  totalAmount        Decimal                  @default(0) @map("total_amount") @db.Decimal(14, 2)
  totalQuantity      Int                      @default(0) @map("total_quantity")
  leadTimeDays       Int                      @default(14) @map("lead_time_days")
  deliveryDate       DateTime?                @map("delivery_date") @db.Date
  shippingAddress    String?                  @map("shipping_address") @db.Text
  billingAddress     String?                  @map("billing_address") @db.Text
  rejectionReason    String?                  @map("rejection_reason") @db.VarChar(255)
  rejectionRemarks   String?                  @map("rejection_remarks") @db.Text
  acceptedAt         DateTime?                @map("accepted_at") @db.Timestamptz(6)
  sourceQuoteRef     String?                  @map("source_quote_ref") @db.VarChar(50)
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  masterOrder        MasterOrder              @relation(fields: [masterOrderId], references: [id], onDelete: Cascade)
  manufacturer       ManufacturerRegistration @relation(fields: [manufacturerId], references: [id], onDelete: Cascade)
  quote              Quote?                   @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  lines              SubOrderLine[]
  purchaseOrder      PurchaseOrder?
  statusHistory      OrderStatusHistory[]
  artworks           OrderArtwork[]

  @@index([masterOrderId], map: "idx_sub_orders_master_order_id")
  @@index([manufacturerId], map: "idx_sub_orders_manufacturer_id")
  @@index([status], map: "idx_sub_orders_status")
  @@index([productionStatus], map: "idx_sub_orders_production_status")
  @@map("sub_orders")
}

model SubOrderLine {
