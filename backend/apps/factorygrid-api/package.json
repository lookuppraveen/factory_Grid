{
  "name": "factorygrid-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "prisma generate && node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed-admin": "node dist/scripts/bootstrap-admin.js",
    "openapi:export": "node dist/scripts/export-openapi.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1150.0",
    "@factorygrid/auth": "workspace:^",
    "@factorygrid/errors": "workspace:^",
    "@fastify/multipart": "^10.1.3",
    "@fastify/static": "^10.1.6",
    "@nestjs/common": "^12",
    "@nestjs/config": "^12",
    "@nestjs/core": "^12",
    "@nestjs/jwt": "^12",
    "@nestjs/platform-fastify": "^12",
    "@nestjs/swagger": "^12",
    "@nestjs/throttler": "^6.7",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "js-yaml": "^5.4.3",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12",
    "@nestjs/schematics": "^12",
    "@nestjs/testing": "^12",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "fastify": "^5.12.7",
    "jest": "^30",
    "prisma": "7.10.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4",
    "typescript": "~6.0.3"
  }
}
