# Copy to deploy/.env.prod on the server and fill in. Never commit .env.prod.
# Generate secrets on the server:
#   openssl rand -hex 24                                   -> POSTGRES_PASSWORD
#   openssl rand -base64 48 | tr -d '\n=+/' | cut -c1-64   -> JWT_SECRET

POSTGRES_PASSWORD=
JWT_SECRET=
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

PORT=8081
SERVER_PORT=8081
THROTTLE_DISABLED=false

# Public address users open. Baked into the frontend build and used for CORS.
# Must match the HTTPS address exactly (no trailing slash).
PUBLIC_URL=https://factorygrid.dualapptech.com
CORS_ALLOWED_ORIGINS=https://factorygrid.dualapptech.com

# First admin, created on first start. Remove the password after logging in once.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Lightsail bucket (Mumbai). Access key from Bucket -> Permissions -> Access keys.
S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com
S3_REGION=ap-south-1
S3_BUCKET=factorygrid-documents-prod
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
